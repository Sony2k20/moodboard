# Local development. Copy to `.env` — `.env` itself is gitignored, this file is not, so no real
# password ever belongs in here.
#
# In the cluster nothing of this is set by hand: CloudNativePG creates the application secret
# when it bootstraps the database cluster, and the chart mounts it. The variable names below are
# the operator's own key names, which is why the application reads them directly.
#
# Locally the database is reached through a port-forward into the cluster:
#
#   kubectl -n prod port-forward svc/moodboard-database-rw 5432:5432
#
# The password is the `password` key of the application secret:
#
#   kubectl -n prod get secret moodboard-database-app -o jsonpath='{.data.password}' | base64 -d
#
# Note that the secret and the database only exist after the first successful sync — before that
# there is nothing to forward to.

DATABASE_URL=postgresql://moodboard:<password>@localhost:5432/moodboard

# Alternatively the individual parts, generic names first, CloudNativePG's key names as a
# fallback (host, port, dbname, username, password):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=moodboard
# POSTGRES_USER=moodboard
# POSTGRES_PASSWORD=
